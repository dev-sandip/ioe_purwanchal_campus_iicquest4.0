{
  "name": "pragya-lekh",
  "displayName": "Pragya Lekh",
  "version": "1.0.0",
  "description": "Pragya Lekh Browser Extension",
  "author": "Sandip Sapkota <contact@thesandip.dev>",
  "scripts": {
    "dev": "pnpm dev:chrome",
    "dev:chrome": "cross-env PLASMO_PUBLIC_BROWSER_NAME='chrome' plasmo dev --target=chrome-mv3",
    "dev:firefox": "cross-env PLASMO_PUBLIC_BROWSER_NAME='firefox' plasmo dev --target=firefox-mv3",
    "build": "pnpm build:chrome",
    "build:chrome": "cross-env PLASMO_PUBLIC_BROWSER_NAME='chrome' plasmo build --target=chrome-mv3",
    "build:firefox": "cross-env PLASMO_PUBLIC_BROWSER_NAME='firefox' plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.15",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "5.3.3"
  },
  "manifest": {
    "manifest_version": 3,
    "name": "Pragya Lekh",
    "short_name": "Pragya Lekh",
    "version": "1.0.0",
    "description": "Pragya Lekh Browser Extension",
    "permissions": [
      "storage",
      "tabs",
      "identity"
    ],
    "host_permissions": [
      "http://localhost:3000/*",
      "https://ioe-purwanchal-campus-iicquest4-0.vercel.app/*",
      "https://ioe-purwanchal-campus-iicquest4-0.vercel.app/api/extension/me",
      "https://ioe-purwanchal-campus-iicquest4-0.vercel.app/login"
    ],
   "web_accessible_resources": [
  {
    "resources": ["tabs/auth-callback.html"],
    "matches": [
      "http://localhost:3000/*",
      "https://ioe-purwanchal-campus-iicquest4-0.vercel.app/*"
    ]
  }
]
  }
}